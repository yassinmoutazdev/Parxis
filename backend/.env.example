# Praxis - Personal AI English Learning Coach
# Copy this file to .env and adjust values as needed

# Database settings
PRAXIS_DB_PATH=./data/praxis.db

# Obsidian vault path (optional bootstrap value -- normally left unset and
# configured instead from the Notes folder card in Settings, which is what
# actually gets watched; this only matters for headless/scripted setups)
# PRAXIS_VAULT_PATH=/path/to/obsidian/vault/EnglishNotes

# Backup settings
PRAXIS_BACKUP_DIR=./data/backups
PRAXIS_BACKUP_RETENTION_DAILY=14
PRAXIS_BACKUP_RETENTION_MONTHLY=6

# Ollama Cloud settings (Praxis is Ollama Cloud-only -- no local/unauthenticated
# mode. Your API key is entered and stored via the in-app Connect screen, not
# here -- get one at https://ollama.com/settings/keys)
# Cloud model tags need a "-cloud" suffix on the direct cloud API
# (e.g. "gemma4:31b" -> "gemma4:31b-cloud").
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1

# Logging
PRAXIS_LOG_LEVEL=INFO

# API server settings
PRAXIS_API_HOST=127.0.0.1
PRAXIS_API_PORT=8000

# CORS origins (comma-separated)
PRAXIS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Watcher debounce duration (seconds)
PRAXIS_WATCHER_DEBOUNCE_SECONDS=2.0