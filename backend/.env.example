# Praxis - Personal AI English Learning Coach
# Copy this file to .env and adjust values as needed

# Database settings
PRAXIS_DB_PATH=./data/praxis.db

# Obsidian vault path
PRAXIS_VAULT_PATH=/path/to/obsidian/vault/EnglishNotes

# Backup settings
PRAXIS_BACKUP_DIR=./data/backups
PRAXIS_BACKUP_RETENTION_DAILY=14
PRAXIS_BACKUP_RETENTION_MONTHLY=6

# Ollama settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=1

# Logging
PRAXIS_LOG_LEVEL=INFO

# API server settings
PRAXIS_API_HOST=127.0.0.1
PRAXIS_API_PORT=8000

# CORS origins (comma-separated)
PRAXIS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Watcher debounce duration (seconds)
PRAXIS_WATCHER_DEBOUNCE_SECONDS=2.0